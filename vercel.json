{
    "builds": [{
      "src": "django_ecommerce/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.12.7" }
    }],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "django_ecommerce/wsgi.py"
      }
    ],
    "env": {
      "MODULE_ENVIRONMENT": "production",
      "DJANGO_SETTINGS_MODULE": "django_ecommerce.settings.production",
      "DATABASE_URL": "postgres://username:password@host:port/database_name"
    }
}