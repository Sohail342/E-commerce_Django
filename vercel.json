{
    "builds": [
      {
        "src": "django_ecommerce/django_ecommerce/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3.9" }
      },
      {
        "src": "build_files.sh",
        "use": "@vercel/static-build",
        "config": {
          "distDir": "django_ecommerce/staticfiles"
        }
      }
    ],
    "routes": [
      {
        "src": "/static/(.*)",
        "dest": "/django_ecommerce/static/$1"
      },
      {
        "src": "/(.*)",
        "dest": "django_ecommerce/django_ecommerce/wsgi.py"
      }
    ],
    "env": {
      "MODULE_ENVIRONMENT": "production",
      "DJANGO_SETTINGS_MODULE": "django_ecommerce.settings.production",
      "DATABASE_URL": "postgresql://neondb_owner:npg_2RXtoQdUuh6l@ep-delicate-wave-a1wr41f1-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
    }
}